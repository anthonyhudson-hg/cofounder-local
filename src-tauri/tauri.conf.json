{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cofounder",
  "version": "0.1.0",
  "identifier": "com.cofounder.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cofounder",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "maximized": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://randomuser.me; style-src 'self' 'unsafe-inline'; connect-src 'self' https://randomuser.me; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sidecar-node"],
    "resources": {
      "../sidecar/dist/": "sidecar/dist/",
      "../sidecar/node_modules/": "sidecar/node_modules/",
      "../sidecar/package.json": "sidecar/package.json"
    }
  }
}
