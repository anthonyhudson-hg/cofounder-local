{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cofounder",
  "version": "0.2.0",
  "identifier": "com.cofounder.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cofounder",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 480,
        "maximized": true,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://randomuser.me; style-src 'self' 'unsafe-inline'; connect-src 'self' https://randomuser.me; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/sidecar-node"],
    "resources": {
      "../sidecar/dist/": "sidecar/dist/",
      "../sidecar/node_modules/": "sidecar/node_modules/",
      "../sidecar/package.json": "sidecar/package.json"
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRTQxMUFBQ0ZERTRERjMKUldUelRkN1BxaEhraTdJYUZIaDQ0SzlEVkdvc0F3OFkzRnBrYzBHSGFQOHNNMnNQKy9UV0JBNTUK",
      "endpoints": [
        "https://github.com/anthonyhudson-hg/cofounder-local/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
